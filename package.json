{
  "name": "sea-state",
  "version": "1.0.0",
  "private": true,
  "description": "Sail seven real-world boats through any weather, from glassy calm to a Category 5 hurricane: a browser ocean, weather and boat simulator built on three.js WebGPU.",
  "keywords": [
    "boat",
    "fft-ocean",
    "ocean",
    "sailing",
    "simulator",
    "three.js",
    "weather",
    "webgpu"
  ],
  "homepage": "https://evanlask.github.io/sea-state/",
  "bugs": {
    "url": "https://github.com/evanlask/sea-state/issues"
  },
  "license": "MIT",
  "author": "Evan Lask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanlask/sea-state.git"
  },
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets/build.ts",
    "assets:report": "node scripts/assets/report.ts",
    "build": "vp build",
    "calibrate": "node scripts/calibrate.ts && vp fmt src/sim/boats/calibration",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "clean": "rm -rf .vite-hooks/_ *.log coverage dist node_modules",
    "dev": "vp dev",
    "lockfile:fix": "node scripts/fix-lockfile-registry.ts",
    "prepare": "vp config",
    "preview": "vp preview",
    "test": "vp test --passWithNoTests",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "title": "Sea State"
}
